{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "ReadDQ", "Effect": "Allow", "Action": "s3:GetObject", "Resource": "arn:aws:s3:::BUCKET/dq/*"},
    {"Sid": "Logs", "Effect": "Allow", "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
     "Resource": ["arn:aws:logs:REGION:ACCOUNT:log-group:/aws/lambda/check_dq",
                  "arn:aws:logs:REGION:ACCOUNT:log-group:/aws/lambda/check_dq:*"]}
  ]
}
