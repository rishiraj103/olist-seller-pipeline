{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "ReadLanding", "Effect": "Allow", "Action": "s3:GetObject", "Resource": "arn:aws:s3:::BUCKET/landing/*"},
    {"Sid": "WriteRaw", "Effect": "Allow", "Action": "s3:PutObject", "Resource": "arn:aws:s3:::BUCKET/raw/*"},
    {"Sid": "Logs", "Effect": "Allow", "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
     "Resource": ["arn:aws:logs:REGION:ACCOUNT:log-group:/aws/lambda/on_batch_arrival",
                  "arn:aws:logs:REGION:ACCOUNT:log-group:/aws/lambda/on_batch_arrival:*"]}
  ]
}
