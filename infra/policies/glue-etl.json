{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "ReadRawAndScripts", "Effect": "Allow", "Action": "s3:GetObject",
     "Resource": ["arn:aws:s3:::BUCKET/raw/*", "arn:aws:s3:::BUCKET/scripts/*"]},
    {"Sid": "WriteOutputs", "Effect": "Allow", "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
     "Resource": ["arn:aws:s3:::BUCKET/curated/*", "arn:aws:s3:::BUCKET/rejected/*", "arn:aws:s3:::BUCKET/dq/*"]},
    {"Sid": "ListOwnPrefixes", "Effect": "Allow", "Action": "s3:ListBucket", "Resource": "arn:aws:s3:::BUCKET",
     "Condition": {"StringLike": {"s3:prefix": ["raw/*", "scripts/*", "curated/*", "rejected/*", "dq/*"]}}},
    {"Sid": "Logs", "Effect": "Allow", "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
     "Resource": "arn:aws:logs:REGION:ACCOUNT:log-group:/aws-glue/*"}
  ]
}
